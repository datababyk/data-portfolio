# === Naver API ===
# Naver Developers에서 발급: https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=your_client_id_here
NAVER_CLIENT_SECRET=your_client_secret_here

# === 관리자 보호 ===
ADMIN_SECRET=change_me_to_random_32_chars

# === 데이터베이스 ===
DB_PATH=./data/trendsensor.db

# === 수집 설정 ===
# 매주 일요일 23:00 KST = 14:00 UTC
COLLECT_CRON_SCHEDULE="0 14 * * 0"
MAX_KEYWORDS_KOREAN=40
MAX_KEYWORDS_FOREIGN=80
